<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CertBuilder.Cli</RootNamespace>
    <AssemblyName>ccb</AssemblyName>

    <!-- Publicação padrão: um executável Windows autocontido e sem arquivos auxiliares. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>

    <!-- Opcional: coloque certbuilder.ico nesta pasta ou informe /p:ApplicationIcon=... -->
    <ApplicationIcon Condition="'$(ApplicationIcon)' == '' and Exists('certbuilder.ico')">certbuilder.ico</ApplicationIcon>

    <!-- Usados pelas opções de versão e "sobre" no menu -->
    <Version>1.0.0</Version>
    <Product>CertBuilder</Product>
    <Authors>Rafael</Authors>
    <Copyright>Copyright © 2026 Rafael Alves. Licenciado sob MIT.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CertBuilder.Core\CertBuilder.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('certbuilder.ico')">
    <Content Include="certbuilder.ico" />
  </ItemGroup>

</Project>
